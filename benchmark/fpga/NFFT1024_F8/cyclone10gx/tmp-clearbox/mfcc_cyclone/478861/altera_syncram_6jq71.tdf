FUNCTION altsyncram_7pjs1 (address_a[2..0], address_b[2..0], clock0, clocken0, data_a[7..0], wren_a)
RETURNS ( q_b[7..0]);

--synthesis_resources = M20K 1 
SUBDESIGN altera_syncram_6jq71
( 
	address_a[2..0]	:	input;
	address_b[2..0]	:	input;
	clock0	:	input;
	clocken0	:	input;
	data_a[7..0]	:	input;
	q_b[7..0]	:	output;
	wren_a	:	input;
) 
VARIABLE 
	altsyncram5 : altsyncram_7pjs1;

BEGIN 
