	altsyncram5.address_b[] = address_b[];
	altsyncram5.clock0 = clock0;
	altsyncram5.clocken0 = clocken0;
	altsyncram5.data_a[] = data_a[];
	altsyncram5.wren_a = wren_a;
	q_b[] = altsyncram5.q_b[];
END;
